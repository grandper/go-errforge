// Package nofmterrorf exercises every layout the nofmterrorf rule rewrites.
// The file already imports errforge and keeps using fmt for Sprintf, so the
// fix must neither add nor remove an import.
package nofmterrorf

import (
	"fmt"
	"io"

	"github.com/grandper/go-errforge/errforge"
)

var ErrNotFound = errforge.New("not found")

const message = "constant message"

func plain() error {
	return errforge.New("an error occurred") // want `do not use fmt.Errorf: use errforge\.New$`
}

func constant() error {
	return errforge.New(message) // want `do not use fmt.Errorf: use errforge\.New$`
}

func formatted(name string) error {
	return errforge.Newf("reading %s", name) // want `do not use fmt.Errorf: use errforge\.Newf$`
}

func percent() error {
	return errforge.Newf("100%% sure") // want `do not use fmt.Errorf: use errforge\.Newf$`
}

func wrap(err error) error {
	return errforge.Wrap("opening resource", err) // want `do not use fmt.Errorf: use errforge\.Wrap$`
}

func wrapf(name string, err error) error {
	return errforge.Wrapf("reading %s", name, err) // want `do not use fmt.Errorf: use errforge\.Wrapf$`
}

func wrapMany(a, b error) error {
	return errforge.Wrap("invalid user", a, b) // want `do not use fmt.Errorf: use errforge\.Wrap$`
}

func link(a, b error) error {
	return errforge.Link(a, b) // want `do not use fmt.Errorf: use errforge\.Link$`
}

func withErr(err error) error {
	return ErrNotFound.WithErr(err) // want `do not use fmt.Errorf: use ErrNotFound\.WithErr$`
}

func withDetail() error {
	return ErrNotFound.WithDetail("user") // want `do not use fmt.Errorf: use ErrNotFound\.WithDetail$`
}

func withDetailf(id int) error {
	return ErrNotFound.WithDetailf("user %d", id) // want `do not use fmt.Errorf: use ErrNotFound\.WithDetailf$`
}

func linkNew() error {
	return errforge.Link(io.EOF, errforge.New("unexpected")) // want `do not use fmt.Errorf: use errforge\.Link$`
}

func linkNewf(id int) error {
	return errforge.Link(io.EOF, errforge.Newf("user %d", id)) // want `do not use fmt.Errorf: use errforge\.Link$`
}

func identity(err error) error {
	return err // want `do not use fmt.Errorf: use the wrapped error itself$`
}

func middle(err error, name string) error {
	return fmt.Errorf("%w while reading %s", err, name) // want `no direct errforge equivalent for this format`
}

func chained(a, b error) error {
	return fmt.Errorf("loading: %w: %w", a, b) // want `no direct errforge equivalent for this format`
}

func indexed(name string) error {
	return fmt.Errorf("%[1]s %[1]s", name) // want `no direct errforge equivalent for this format`
}

func dynamic(format string) error {
	return fmt.Errorf(format) // want `the format is not a constant`
}

func spread(args []any) error {
	return fmt.Errorf("a %s and a %s", args...) // want `the format is not a constant`
}

func keepsFmt() string {
	return fmt.Sprintf("%d", 1)
}
